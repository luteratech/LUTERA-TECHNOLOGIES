{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": [
    "dub1"
  ],
  "crons": [
    {
      "path": "/api/jobs",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/jobs/backup",
      "schedule": "0 7 * * 1"
    }
  ]
}
