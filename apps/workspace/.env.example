# Server-only variables. Never commit .env.local or put these in NEXT_PUBLIC_*.
SUPABASE_URL=https://zwtjemhrubzgaueuyuxn.supabase.co
SUPABASE_PUBLISHABLE_KEY=
WORKSPACE_ORIGIN=https://YOUR-PRIVATE-PROJECT.vercel.app
# Generate with: openssl rand -hex 24. Save in a password manager.
WORKSPACE_ENTRY=
# Server-only 64 hex characters; matching SHA-256 digest in private.work_rate_config.
AUTH_RATE_SECRET=
# Optional: deploy hook for the EXISTING PUBLIC WEBSITE project, not this app.
PUBLIC_SITE_DEPLOY_HOOK=
PUBLIC_SITE_ORIGIN=https://luteratech.com

# Server-only malware scanning. Saving the Bouncer key selects it automatically.
# Never use NEXT_PUBLIC_ for this key. Free accounts only; no automatic paid upgrade.
BOUNCER_API_KEY=
# Optional explicit selector: bouncer | clamav | none. Selecting bouncer without a key blocks uploads.
ATTACHMENT_SCANNER_PROVIDER=
